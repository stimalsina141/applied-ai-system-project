# Copy this file to .env to change settings. .env is git-ignored.
# Nothing here is required: by default the coach uses a free model running
# locally through Ollama (see README setup).

# Which AI to use: "ollama" (free, local, default) or "claude" (paid Anthropic API)
# COACH_PROVIDER=ollama
# COACH_MODEL=qwen2.5-coder:3b   # 7b if you have 16 GB+ RAM; for Claude, e.g. claude-opus-5-5
# COACH_OLLAMA_URL=http://localhost:11434

# Only needed when COACH_PROVIDER=claude
# ANTHROPIC_API_KEY=your-api-key-here
# COACH_EFFORT=medium            # low | medium | high | xhigh | max

# Guardrails
# COACH_MAX_ATTEMPTS=3
# COACH_TEST_TIMEOUT=30          # seconds
