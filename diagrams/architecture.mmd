%% AI Debugging Coach - System Architecture
%% The AI proposes and reasons; controlled application logic validates and executes.
%% Legend: blue = AI model (free local Qwen2.5-Coder via Ollama by default), gray = application logic, green = testing check, orange = human check

flowchart TD
    IN[/"INPUT<br/>buggy Python code, tests,<br/>error message, bug description"/]

    subgraph AGENT["Agent loop (coach/agent.py) - max 3 attempts"]
        BASE["Tester: run tests<br/>before any change"]
        DIAG["AI Diagnoser<br/>finds the bug, labels each finding<br/>confirmed / likely / unknown,<br/>rates confidence, explains it simply"]
        PATCH["AI Fixer<br/>names the target function,<br/>then writes its fixed version"]
        GUARD{"Guardrails<br/>only the declared function?<br/>valid Python? tests untouched?"}
        HUMAN{"Learner reviews diff<br/>approve or reject"}
        TEST["Tester: sandboxed pytest<br/>temp copy, fixed command, timeout"]
        KEEP{"Evaluator<br/>fewer failures and<br/>nothing newly broken?"}
        ANALYZE["AI Analyzer<br/>explains failing tests,<br/>suggests next step"]
    end

    OUT[/"OUTPUT<br/>status from test results, diff, fixed file,<br/>reliability table, report, follow-up chat"/]
    EVAL[["Reliability eval (eval/run_eval.py)<br/>runs all examples against known answers:<br/>fix rate, diagnosis accuracy, consistency"]]
    REVIEW[["Human evaluation<br/>(eval/human_review.md)<br/>person grades AI explanations"]]
    LOG[("Workflow log<br/>logs/coach.log")]

    IN --> BASE --> DIAG --> PATCH --> GUARD
    GUARD -- blocked --> PATCH
    GUARD -- ok --> HUMAN
    HUMAN -- "reject + reason" --> PATCH
    HUMAN -- approve --> TEST --> KEEP
    KEEP -- "tests still failing<br/>and attempts left" --> ANALYZE --> PATCH
    KEEP -- "all pass or<br/>no attempts left" --> OUT

    EVAL -. "runs the same loop" .-> AGENT
    OUT -.-> REVIEW
    AGENT -.-> LOG

    classDef ai fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef app fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef test fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef human fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    class DIAG,PATCH,ANALYZE ai
    class GUARD,IN,OUT,LOG app
    class BASE,TEST,KEEP,EVAL test
    class HUMAN,REVIEW human
